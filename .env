APP_NAME=php-vue3-app
APP_ENV=development
POSTGRES_DB_CONNECTION=pgsql
POSTGRES_DB_HOST=postgres
POSTGRES_DB_DATABASE=laravel-vue-app
POSTGRES_DB_USERNAME=php-vue3-app-user
POSTGRES_DB_PASSWORD=123php-vue3-appUser#321!
POSTGRES_DB_HOST_PORT=5438
POSTGRES_DB_PORT=5432
REDIS_HOST_PORT=6379
REDIS_PORT=6379
REDIS_HOST=redis-alpine

FPM_PORT=9000
HTTP_HOST_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443

NODE_ENV=development
VITE_API_URL=http://localhost:8080/api
VITE_PORT=5173












# --- Themes / separated apps -------------------------------------------------
# Standalone frontends (docker compose --profile standalone up); emailed links
# for clinic / market accounts open these when set.
# Only set these while the standalone apps run (`docker compose --profile standalone up`):
# otherwise emailed links would open ports nobody listens on. Unset = the multi app
# (FRONTEND_URL, :5173), which serves every theme.
#FRONTEND_URL_DOCTOR=http://localhost:5174
#FRONTEND_URL_MARKETPLACE=http://localhost:5175
# Backend: themes served, empty = all. Frontend: themes offered by the multi app.
TENANCY_THEMES=
VITE_APP_THEMES=
AUTH_VERIFY_EMAIL=true

# --- Realtime / live chat (Laravel Reverb) ------------------------------------
# App credentials shared by Laravel (publisher) and the reverb server. The key is
# public (browsers send it); keep the secret private and rotate it per environment.
REVERB_APP_ID=720382
REVERB_APP_KEY=537776934967fa64fed1
REVERB_APP_SECRET=903f8645bf480a855145f6aec20ca37403a26c4c
# Where browsers open the websocket: nginx proxies /app/* on HTTP_HOST_PORT to reverb
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8080
REVERB_PUBLIC_SCHEME=http
# Hosts allowed to connect, comma separated (e.g. "localhost,app.example.com"); * = any
REVERB_ALLOWED_ORIGINS=*
